NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/blue-carbon-mrv
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRE=7d
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
POLYGON_RPC_URL=https://polygon-rpc.com
ADMIN_WALLET=0x0000000000000000000000000000000000000000

# ────────────────────────────────────────────────
# Blockchain / Smart Contract Configuration
# ────────────────────────────────────────────────

# JSON-RPC endpoint for the target network
# Local Hardhat node:  http://127.0.0.1:8545
# Sepolia testnet:     https://sepolia.infura.io/v3/YOUR_INFURA_KEY
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Private key of the backend signing wallet (hex, with or without 0x prefix)
# This wallet must hold ADMIN_ROLE on the contract (granted by deploy.ts)
# NEVER commit the real key — use a secrets manager in production
PRIVATE_KEY=0xYOUR_ADMIN_PRIVATE_KEY

# Deployed contract address — auto-populated by deploy.ts via contract-config.json,
# but can also be set manually for existing deployments
CONTRACT_ADDRESS=0xDEPLOYED_CONTRACT_ADDRESS

# Ethereum address derived from PRIVATE_KEY above.
# Used by deploy.ts to grant ADMIN_ROLE / VALIDATOR_ROLE / FIELD_OFFICER_ROLE
BACKEND_WALLET=0xYOUR_BACKEND_WALLET_ADDRESS

# Number of block confirmations to wait after broadcasting a tx (default: 1)
# Increase to 2-3 on mainnet for extra finality safety
CONFIRMATION_BLOCKS=1

# ────────────────────────────────────────────────
# Contracts directory .env (contracts/.env.example)
# ────────────────────────────────────────────────
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
# ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
